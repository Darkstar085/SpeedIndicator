<?xml version="1.0" encoding="utf-8"?>
<!-- Data extraction rules (API 31+ devices), mirrors backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="net_speed_indicator.db" />
        <exclude domain="file" path="updates/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="net_speed_indicator.db" />
        <exclude domain="file" path="updates/" />
    </device-transfer>
</data-extraction-rules>